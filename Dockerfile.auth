# Use Python 3.11 slim image
FROM python:3.11-slim

# Install curl for API calls
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir flask==2.3.2 numpy==1.26.4

# Copy only files needed for auth server
COPY run_compare/__init__.py run_compare/
COPY run_compare/constants.py run_compare/
COPY auth_server.py .

# Expose OAuth callback port
EXPOSE 3476

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV TOKEN_FILE_PATH=/app/global.json

# Run the Flask auth server
CMD ["python", "auth_server.py"]